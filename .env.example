# Copy to .env.local for local development. On Netlify, set these under
# Site configuration, Environment variables.

# Where the shop's API lives.
# Local development: your own backend. Production: the live API.
NEXT_PUBLIC_API_URL=http://127.0.0.1:8000

# This storefront's own address (used for share links and the sitemap).
NEXT_PUBLIC_SITE_URL=http://localhost:3000